{
  "routes": [
    { "src": "/favicon\.ico", "dest": "/public/favicon.ico" },
    { "src": "/favicon\.png", "dest": "/public/favicon.png" },

    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/openapi\.json", "dest": "/api/index.py" },

    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
